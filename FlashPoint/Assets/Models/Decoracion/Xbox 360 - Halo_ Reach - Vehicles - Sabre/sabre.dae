  <library_effects>
    <effect id="falcon_engine-fx" name="falcon_engine">
      <profile_COMMON>
        <newparam sid="falcon_engine-diffuse-surface">
          <surface type="2D">
            <init_from>falcon_engine-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="falcon_engine-diffuse-sampler">
          <sampler2D>
            <source>falcon_engine-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <phong>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="falcon_engine-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <specular>
              <color sid="specular">0   0   0   1</color>
            </specular>
            <reflective>
              <color sid="reflective">0   0   0   1</color>
            </reflective>
            <transparent>
              <color sid="transparent">1   1   1   1</color>
            </transparent>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
